# Roamly production environment template
# Copy to .env for local development. Never commit real credentials.

# Required LLM configuration
GROQ_API_KEY=replace_with_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# Required LangGraph PostgreSQL persistence
DATABASE_URL=postgresql://username:password@hostname:5432/database

# MCP credentials
TAVILY_API_KEY=replace_with_tavily_api_key
AVIATION_STACK_API_KEY=replace_with_aviationstack_api_key
OPENWEATHER_API_KEY=replace_with_openweather_api_key

# Optional LangSmith tracing
LANGCHAIN_TRACING=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=replace_with_langsmith_api_key
LANGCHAIN_PROJECT=Roamly

# Optional runtime controls
MCP_RETRIES=2
MCP_CACHE_TTL_SECONDS=300
UVX_COMMAND=uvx
HOST=127.0.0.1
PORT=8000
RELOAD=false
